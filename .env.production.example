# Used by docker-compose.prod.yml. Copy to .env.production (never commit it).

# Database (the compose file builds DATABASE_URL from these).
POSTGRES_USER=resumeforge
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=resumeforge

# Public URL of the app. With the bundled nginx, the API is on the same origin under /api.
CORS_ORIGINS=https://resumeforge.example.com
FRONTEND_URL=https://resumeforge.example.com

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_RATE_LIMIT=10/hour;30/day

GITHUB_API_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://resumeforge.example.com/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://resumeforge.example.com/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://resumeforge.example.com/api/auth/linkedin/callback

# local = the "uploads" volume; s3 = any S3-compatible bucket (recommended).
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
