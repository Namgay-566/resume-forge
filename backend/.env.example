# Copy to .env and adjust.
APP_NAME=ResumeForge
# production turns on the safety checks (the app refuses to start with unsafe settings),
# HSTS, and turns off /docs.
ENVIRONMENT=development

# Matches docker-compose.yml defaults. Managed Postgres URLs (postgres://...?sslmode=require)
# can be pasted as-is; they're converted for asyncpg.
DATABASE_URL=postgresql+asyncpg://resumeforge:resumeforge@localhost:5432/resumeforge

# Comma-separated list of allowed origins (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Browser redirect target after Google, LinkedIn or GitHub sign-in.
FRONTEND_URL=http://localhost:5173

# Auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set to true in production (HTTPS only).
COOKIE_SECURE=false
# lax when the app and API share a site (app.example.com + api.example.com, or one origin).
# none only for different sites (e.g. *.vercel.app + *.onrender.com); needs COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# GitHub OAuth (optional). Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials >
# Create credentials > OAuth client ID (type: Web application). See README "Google sign-in".
# Authorised redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# LinkedIn sign-in (optional). https://www.linkedin.com/developers/apps > Create app, then
# add the "Sign In with LinkedIn using OpenID Connect" product. See README "LinkedIn sign-in".
# Authorized redirect URL: http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# AI provider: anthropic | openai. AI_MODEL is optional (defaults: claude-opus-5 / gpt-5).
AI_PROVIDER=anthropic
AI_MODEL=
# Anthropic key: https://platform.claude.com/settings/keys  OpenAI key: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Anthropic only. low | medium | high | xhigh | max (medium keeps resume import fast).
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=120
# Per-user limit on AI endpoints, e.g. "10/hour;30/day". Use redis://... with several workers.
AI_RATE_LIMIT=10/hour;30/day
# memory:// is per process. Production must share counters: redis://host:6379/1
RATE_LIMIT_STORAGE_URI=memory://
# Per client IP on login/register/refresh; per user on uploads and exports.
AUTH_RATE_LIMIT=10/minute;100/hour
REFRESH_RATE_LIMIT=120/minute
UPLOAD_RATE_LIMIT=20/hour;60/day
EXPORT_RATE_LIMIT=60/hour
# Bodies over this are refused before they're read (uploads are capped at 5 MB).
MAX_REQUEST_BYTES=6291456

# Proof analysis jobs. inline = in the API process (dev); rq = Redis queue + a worker
# (`rq worker proofs --url $REDIS_URL`), required in production.
JOB_QUEUE=inline
REDIS_URL=redis://localhost:6379/0
JOB_TIMEOUT_SECONDS=600

# GitHub REST API token used to analyse proof repos (read-only access to public repos).
# Create at https://github.com/settings/personal-access-tokens . Optional but strongly
# recommended: unauthenticated requests are limited to 60 per hour.
GITHUB_API_TOKEN=

# Uploaded proof files (certificates). local = ./storage (dev); s3 = S3-compatible (recommended in prod).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local testing only: password for the demo users created by `python -m app.db.demo`.
# Refused in production.
DEMO_PASSWORD=
